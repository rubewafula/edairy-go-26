APP_NAME=EDAIRY
APP_ENV=production
PORT=8000
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=example_dairy_erp
DB_USER=edairy
DB_PASSWORD=
ENV=production
JWT_SECRET=
JWT_EXPIRY_HOURS=24
GIN_MODE=release

# Mobile payout provider settings (defaults for all channels of that provider).
# Per-channel overrides can be stored in disbursement_channel_config via admin UI
# (Loans → Disbursement Channels → Edit → Provider Configuration).
# Resolution order: DB config → env vars → built-in defaults.

# DTB / Astra Africa (loan disbursement via KE_DTB_MPESA)
ASTRA_API_BASE_URL=
ASTRA_AUTHENTICATION_API_BASE_URL=
MONEY_TRANSFER_BASE_URL=
AUTH_IDENTITY=
ASTRA_TENANT_PASSWORD=
WITHDRAWAL_CALLBACK_URL=https://dev.edairy.africa/api/withdrawal-callback
VERIFY_SSL=true
ASTRA_CONNECT_TIMEOUT_SEC=10
ASTRA_REQUEST_TIMEOUT_SEC=60

# Safaricom Daraja B2C (MOBILE_MPESA)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_CERT_PATH=
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_RESULT_URL=https://dev.edairy.africa/api/mpesa-b2c-result
MPESA_B2C_TIMEOUT_URL=https://dev.edairy.africa/api/mpesa-b2c-timeout

# Airtel Africa Disbursement (MOBILE_AIRTEL)
AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=KE
AIRTEL_CURRENCY=KES
AIRTEL_DISBURSEMENT_PIN=
AIRTEL_PUBLIC_KEY_PATH=
AIRTEL_CALLBACK_URL=https://dev.edairy.africa/api/airtel-disbursement-callback

# Equity Finserve / Jenga (MOBILE_EQUITEL)
JENGA_ENV=sandbox
JENGA_API_KEY=
JENGA_MERCHANT_CODE=
JENGA_CONSUMER_SECRET=
JENGA_PRIVATE_KEY_PATH=
JENGA_SOURCE_ACCOUNT=
JENGA_SOURCE_ACCOUNT_NAME=
JENGA_SOURCE_COUNTRY_CODE=KE
JENGA_CALLBACK_URL=https://dev.edairy.africa/api/jenga-mobile-callback
